# Port the BlogBuilder server listens on.
PORT=4321

# Path to the git repository BlogBuilder should load. Must contain
# content/config.json. Defaults to the bundled example-site when unset,
# which is only useful for local development / trying the builder out.
BLOG_REPO_PATH=./example-site

# Nothing else is required. The AI copilot is BYOK - keys are entered in the
# GUI's Settings tab and stored in the browser, never in this file or on disk.
